<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Single-hop canonical redirect: Force HTTPS and non-www (calevi.com.br)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.calevi\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://calevi.com.br/$1 [R=301,L]

  # 2. Teleprompter Direct Route (matches /teleprompter and /teleprompter/)
  RewriteRule ^teleprompter/?$ /teleprompter/index.html [L]

  # 3. SPA Route Fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Anti-indexing headers for Teleprompter (Google & other bots)
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/teleprompter" NOINDEX_TELEPROMPTER=1
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=NOINDEX_TELEPROMPTER
</IfModule>

# Long-term Immutable Caching Headers for Fonts, Images, CSS & JS
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|woff|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Caching & Performance for Hostinger / Apache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
